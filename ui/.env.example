# Copy to `.env.local` (git-ignored) and adjust per environment.
#
# Vite only exposes variables prefixed with VITE_, and they are baked in at
# BUILD time -- changing one requires `npm run build`, not just a restart.

# ---------------------------------------------------------------------------
# Session-provisioning webhook (n8n workflow "Interview Practice - A").
#
# Must be the PRODUCTION /webhook/ path. The /webhook-test/ path only responds
# while an n8n editor tab is actively listening, which is a confusing failure
# to debug later -- it works for you and for nobody else.
# ---------------------------------------------------------------------------
VITE_PROVISION_WEBHOOK_URL=https://n8n.example.org/webhook/interview-provision

# ---------------------------------------------------------------------------
# Status endpoint the UI polls while provisioning runs (90-140s).
# Must match the "interview-status" webhook path in the same workflow.
# ---------------------------------------------------------------------------
VITE_STATUS_WEBHOOK_URL=https://n8n.example.org/webhook/interview-status

# ---------------------------------------------------------------------------
# Employment specialist roster, as a JSON array of {name, email, location?}.
#
# This decides where each interview report is emailed, so it must hold real
# addresses before any real participant uses the tool. Omit it and the UI falls
# back to the placeholder list in src/config/specialists.ts AND shows an on-screen
# warning that placeholder data is in use.
#
# Setting it here rather than editing specialists.ts keeps real staff addresses out
# of version control.
# ---------------------------------------------------------------------------
# VITE_SPECIALISTS=[{"name":"Jane Doe","email":"jdoe@example.org","location":"South Office"}]

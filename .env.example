# ============================================================================
# Interview Practice AI -- deployment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# IMPORTANT: this file configures the TOOLING in tools/ and documents the values
# you will need while following docs/SETUP.md. It is NOT read by the n8n
# workflows at runtime.
#
# The workflows get their secrets from n8n's own credential store, by
# credential NAME. That is deliberate: an API key must never appear in a
# workflow body, an expression, a header parameter, or this file. The names the
# workflows expect are listed under "n8n credential names" below.
# ============================================================================


# ----------------------------------------------------------------------------
# n8n -- where the two workflows live
# ----------------------------------------------------------------------------
# Public base URL of your n8n instance.
N8N_BASE_URL=https://n8n.example.org

# Public API, used by tools/deployed.py to export and verify the workflows.
N8N_API_BASE_URL=https://n8n.example.org/api/v1

# n8n public API key: Settings -> API -> create an API key.
# Read-only use by the tooling, but it can write -- treat it as a secret.
N8N_API_KEY=

# Workflow IDs, filled in after you import the two workflows (step 5 of SETUP).
# Visible in the editor URL: /workflow/<id>
WORKFLOW_A_ID=
WORKFLOW_B_ID=


# ----------------------------------------------------------------------------
# Webhook paths -- must match what the imported workflows declare
# ----------------------------------------------------------------------------
# POST, returns 202 immediately and provisions in the background.
PROVISION_WEBHOOK_PATH=interview-provision

# GET ?sessionId=... , polled by the UI every 3s.
STATUS_WEBHOOK_PATH=interview-status

# POST, receives Vapi's end-of-call-report.
#
# ** The full URL of this one is stamped onto every assistant as `server.url`.
# ** It MUST be reachable from the public internet -- Vapi calls it, not you.
# ** Set it in the "Build Assistant Body" code node after import. A localhost
# ** or LAN address here means reports silently never arrive.
REPORT_WEBHOOK_PATH=interview-report
REPORT_WEBHOOK_URL=https://n8n.example.org/webhook/interview-report


# ----------------------------------------------------------------------------
# n8n credential names -- create these in n8n with these EXACT names
#
# The imported workflow JSON references credentials by name, so a mismatch
# shows up as "credential not found" on the first run. Change a name here only
# if you also change it on every node that uses it.
# ----------------------------------------------------------------------------
# httpBearerAuth            "Vapi API (Interview Practice)"        -- Vapi PRIVATE key
# postgres                  "Postgres - Interview Practice"        -- the database below
# azureOpenAiApi            "Azure Open AI account"                -- or swap for another LLM
# perplexityApi             "Perplexity API (Interview Practice)"  -- OPTIONAL, fallback only
# microsoftOutlookOAuth2Api "Microsoft Outlook account"            -- or swap for SMTP/Gmail


# ----------------------------------------------------------------------------
# Database -- values you enter into the n8n Postgres credential
# ----------------------------------------------------------------------------
# Host as seen FROM THE n8n CONTAINER. If Postgres is a sibling container on
# the same Docker network this is the service name, not localhost.
PGHOST=postgres
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable


# ----------------------------------------------------------------------------
# Vapi -- the voice platform
# ----------------------------------------------------------------------------
# PRIVATE key (the public key is browser-only and cannot read or write
# assistant configs). Used by tools/ for read-only checks; the workflows read
# it from the n8n credential store instead.
#
# Convention: keep it OUTSIDE the repo at ~/.vapi/credentials.json as
# {"apiKey":"..."} . tools/ look there if this is unset.
VAPI_API_KEY=

# How many phone numbers you provisioned. This is your HARD concurrency
# ceiling -- participant N+1 gets "all practice lines are busy", not a failure.
# 3-5 is sensible; 5 is what the reference deployment ran.
POOL_SIZE=5

# Area code requested when provisioning numbers (US).
POOL_AREA_CODE=314


# ----------------------------------------------------------------------------
# LLM -- Azure OpenAI in the reference build
# ----------------------------------------------------------------------------
# Endpoint form is https://<resource>.openai.azure.com with NO path appended.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_KEY=

# Strongly recommended: give this system its OWN model deployment rather than
# sharing one with other workloads. Azure meters tokens per deployment, so a
# dedicated deployment is the only way to see what this system actually costs.


# ----------------------------------------------------------------------------
# Research fallback -- OPTIONAL
#
# Only used when the job URL cannot be fetched or the user supplied a bare job
# title. The primary path is a direct page fetch plus the LLM, which is more
# faithful, free, and has no rate limit. Leave unset to disable the fallback.
# ----------------------------------------------------------------------------
PERPLEXITY_API_KEY=


# ----------------------------------------------------------------------------
# Intake UI
# ----------------------------------------------------------------------------
UI_PORT=8090

# The UI has its own build-time config -- see ui/.env.example. These must agree
# with PROVISION_WEBHOOK_PATH and STATUS_WEBHOOK_PATH above.


# ----------------------------------------------------------------------------
# Behaviour tunables -- edit in the workflow code nodes, listed here so you know
# they exist
# ----------------------------------------------------------------------------
# STALE_AFTER_MINUTES = 120   find-stale-sessions.jsCode.js
#     How long before the sweep reclaims a line provisioned for someone who
#     never called. Must exceed maxDurationSeconds.
#
# maxDurationSeconds = 1800   build-assistant-body.jsCode.js
#     Hard cap on a single call. A SAFETY CUTOFF, not a target -- it exists so a
#     stuck call cannot hold a line forever. Real interviews run 3-7 minutes.
#
# TOO_SHORT_SECONDS = 60      prepare-report-inputs.jsCode.js
#     Below this, the report is banner-flagged as not a fair picture.
#
# MIN_CHARS = 600             assess-fetched-page.jsCode.js
#     Minimum readable text before a fetched job page is considered usable.
